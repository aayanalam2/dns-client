{
  "name": "dns-client",
  "version": "0.1.0",
  "description": "Minimal DNS client library in TypeScript supporting A, AAAA and CNAME",
  "main": "dist/src/cli.js",
  "bin": {
    "dns-client": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/cli.js",
    "web": "node dist/src/web.js",
    "test": "npm run build && node dist/test/run.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "type": "module"
}
